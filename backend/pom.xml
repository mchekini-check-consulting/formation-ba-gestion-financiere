<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>com.example</groupId>
	<artifactId>gestion-financiere</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>gestion-financiere</name>
	<description>Gestion financiere microservice</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jackson</artifactId>
		</dependency>
		<!-- Contrat d'interface des API (OpenAPI), généré depuis les contrôleurs :
		     /v3/api-docs (JSON) et /swagger-ui.html (page de consultation et d'essai).
		     Activé seulement si POINTEO_SWAGGER=true (application.yaml). -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.2.0</version>
		</dependency>
		<!-- Envoi des emails par SMTP (notification/EnvoiEmailConfiguration) : Mailpit de la
		     plateforme en dev/qualif, Mailpit de compose.yaml en local. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- Mots de passe stockés hachés (BCrypt) ; seulement la brique "crypto",
		     sans activer Spring Security sur les autres routes -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Base PostgreSQL : connexion lue dans SPRING_DATASOURCE_* (injectées par la
		     plateforme, helm.yaml : database), schéma versionné par Flyway -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Tests d'intégration (*IT) : PostgreSQL jetable dans Docker (Testcontainers) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Lancement local uniquement (./mvnw spring-boot:run), jamais dans l'image :
					     factures d'exemple (mode test), Swagger, emails dans le Mailpit local (application.yaml). -->
					<environmentVariables>
						<POINTEO_MODE_TEST>true</POINTEO_MODE_TEST>
						<POINTEO_SWAGGER>true</POINTEO_SWAGGER>
						<!-- Emails envoyés au Mailpit de compose.yaml (http://localhost:8025) -->
						<SMTP_HOST>localhost</SMTP_HOST>
					</environmentVariables>
				</configuration>
			</plugin>
			<!-- Couverture des tests unitaires : target/site/jacoco/jacoco.xml (lu par Sonar) -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
